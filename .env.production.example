APP_NAME="BaiFa Tracking"
APP_ENV=production
APP_KEY=base64:XG8d2L5vX4tW+9j0+Mv5Y/5qC2v0Fv9xG0zL8tW+Mv4=
APP_DEBUG=false
APP_URL=https://api.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Configuración de Base de Datos MySQL en cPanel
# En cPanel el host suele ser 'localhost' o '127.0.0.1'
# Recuerda que el nombre de usuario y base de datos en cPanel llevan el prefijo de tu cuenta (ej: cpaneluser_baifadb)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nombre_cpanel_baifa
DB_USERNAME=usuario_cpanel_baifa
DB_PASSWORD="tu_password_segura"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuración de Correo SMTP (usando las cuentas creadas en cPanel)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@tudominio.com
MAIL_PASSWORD="tu_password_de_correo"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notificaciones@tudominio.com"
MAIL_FROM_NAME="BaiFa Power"

# URL pública de tu Frontend (baifa-ui) en cPanel
# Usado para los botones y enlaces en correos (recuperación de contraseña, notificaciones)
FRONTEND_URL="https://tudominio.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
